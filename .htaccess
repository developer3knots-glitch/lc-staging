# LiveChat — shared hosting (cPanel / Apache)
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Force HTTPS when SSL is enabled (uncomment after SSL is active)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# PHP limits: set in cPanel → MultiPHP INI Editor (php_value here can cause 403 on some hosts)

# Block direct access to sensitive folders (install.php still works at root)<IfModule mod_authz_core.c>
    <FilesMatch "^(config\.php|db\.php|\.env)$">
        Require all denied
    </FilesMatch>
</IfModule>

Options -Indexes
