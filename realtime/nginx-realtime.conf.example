# Nginx snippet — wss://erp.3knotsdigital.com/lc-realtime -> Node :6001
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Prefer a path on the same host as the PHP app:
# location /lc-realtime/ { ... proxy to 127.0.0.1:6001 ... }
#
# Or dedicated subdomain:
server {
    listen 443 ssl http2;
    server_name erp.3knotsdigital.com;

    # ssl_certificate ...
    # ssl_certificate_key ...

    location /lc-realtime/ {
        proxy_pass http://127.0.0.1:6001/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    location = /lc-realtime/publish {
        proxy_pass http://127.0.0.1:6001/publish;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        allow 127.0.0.1;
        deny all;
    }
}
