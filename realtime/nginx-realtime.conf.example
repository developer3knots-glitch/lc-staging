# Nginx — wss://livechat.3knotsdigital.com/lc-realtime -> Node :6001
# Paste location into aaPanel site config for livechat.3knotsdigital.com
# Full steps: realtime/AAPANEL-SETUP.md

location /lc-realtime {
    proxy_pass http://127.0.0.1:6001/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
    # Required for visitor SSE (/lc-realtime/sse) — otherwise nginx buffers events
    proxy_buffering off;
    proxy_cache off;
}
