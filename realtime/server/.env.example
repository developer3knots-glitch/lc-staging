# Copy to .env on aaPanel (realtime/server/.env)
PORT=6001
HOST=127.0.0.1
# MUST match PHP LC_REALTIME_SECRET / config.realtime.local.php secret
LC_REALTIME_SECRET=local-dev-realtime-secret
# Bridge visitor.receipt_ack / message.ack → PHP (delivered/read + message.receipts)
# Same-host aaPanel example (Host header if vhost needs it):
# LC_VISITOR_ACK_URL=http://127.0.0.1/api/visitor-ack.php
# LC_VISITOR_ACK_HOST=livechat.3knotsdigital.com
# Or full public URL:
# LC_VISITOR_ACK_URL=https://livechat.3knotsdigital.com/api/visitor-ack.php
# Agent Online last_seen touch (replaces browser agent-status.php 45s poll):
# LC_AGENT_TOUCH_URL=https://livechat.3knotsdigital.com/api/agent-ws-touch.php
# LC_AGENT_TOUCH_HOST=livechat.3knotsdigital.com
